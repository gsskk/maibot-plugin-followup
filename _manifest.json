{
  "manifest_version": 2,
  "id": "gsskk.followup-window",
  "version": "0.3.0",
  "name": "麦麦留步",
  "description": "群里被 @ 或被引用回复后给这个人开一个跟进窗口,窗口里他不带 @ 的追问会被当作提到了 bot,一定进入 Planner;别人的闲聊照常走门控。",
  "author": {
    "name": "gsskk",
    "url": "https://github.com/gsskk"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/gsskk/maibot-plugin-followup"
  },
  "host_application": {
    "min_version": "1.3.17",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.19.99"
  },
  "dependencies": [],
  "capabilities": [
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
